generator client {
  provider        = "prisma-client-js"
  output          = "./generated/client"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Property {
  id                       Int     @id @default(autoincrement())
  CodigoImovel             String
  TipoImovel               String?
  SubTipoImovel            String?
  CategoriaImovel          String?
  Cidade                   String
  Bairro                   String?
  Endereco                 String?
  CEP                      String?
  PrecoVenda               Float?
  PrecoLocacao             Float?
  PrecoLocacaoTemporada    Float?
  AreaUtil                 Float?
  AreaTotal                Float?
  QtdDormitorios           Int?
  QtdSuites                Int?
  QtdBanheiros             Int?
  QtdSalas                 Int?
  QtdVagas                 Int?
  QtdElevador              Int?
  QtdUnidadesAndar         Int?
  QtdAndar                 Int?
  Observacao               String?
  ArCondicionado           Int?
  Varanda                  Int?
  ProntoMorar              Int?
  Lavabo                   Int?
  TipoOferta               Int?
  Churrasqueira            Int?
  Copa                     Int?
  WCEmpregada              Int?
  Piscina                  Int?
  EstacionamentoVisitantes Int?
  Playground               Int?
  QuadraTenis              Int?
  QuadraPoliEsportiva      Int?
  SalaGinastica            Int?
  SalaoFestas              Int?
  SalaoJogos               Int?
  Interfone                Int?
  campodefutebol           Int?
  PrecoCondominio          Int?
  NomeCondominio           String?
  video                    String?

  photos Photo[]
}

model Photo {
  id          Int     @id @default(autoincrement())
  property_id Int
  URLArquivo  String? @db.VarChar(1500)
  Principal   Int?
  Alterada    Int?

  property Property @relation(fields: [property_id], references: [id])
}
